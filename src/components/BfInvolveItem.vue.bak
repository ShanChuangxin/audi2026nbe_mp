<!-- 我参与项入口 -->
<script setup lang="ts">

import {computed } from 'vue';
// import type { AccessTicketType } from '@/types/access_ticket'
import { getInvolveListAPI } from '@/services/access_ticket'
import type { OrderInfoType } from '@/types/order'

// 定义Props接收参数
const props = defineProps<{ // 定义变量接收，后续可以在js中继续使用
    involve_info: OrderInfoType;
}>()


// 计算属性用于显示时间段的起始时间和结束时间
const start_time = computed(() => {
    const timestamp = props.involve_info.time_node_start * 1000;
    const date = new Date(timestamp)
    // 获取时分
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    const formatTime = `${hours}:${minutes}`
    return formatTime
})
const end_time = computed(() => {
    const timestamp = props.involve_info.time_node_end * 1000;
    const date = new Date(timestamp)
    // 获取时分
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    const formatTime = `${hours}:${minutes}`
    return formatTime
})

// 计算属性用于显示门禁状态
const ticket_status = computed(() => {
  const now = Math.floor(Date.now() / 1000);    // 精确到秒
//   console.log("--------------------")
//   console.log("当前时间戳：", now)
//   console.log("起始时间戳：", props.ticket_info.time_node_start)
//   console.log("结束时间戳：", props.ticket_info.time_node_end)
  if (now >= props.involve_info.time_node_end){
    // console.log("已结束")
    return "已结束";
  } else if (now >= props.involve_info.time_node_start){
    // console.log("进行中")
    return "进行中";
  }
  else {
    // console.log("未开始")
    return "未开始";
  }
});


</script>

<template>
    <navigator :url="`/pages/access_ticket/access_ticket?access_ticket_id=${ticket_info.ticket_id}`" open-type="navigate"
        hover-class="navigator-hover" class="space-item">

        <!-- 会议室信息区域 -->
        <view class="office-info-container">
            <view class="office-cover">
                <!-- <image src="/src/static/mock/index/space-cover.png" mode="scaleToFill" /> -->
                <image :src="ticket_info.office_cover" mode="scaleToFill" />
            </view>
            <view class="office-content">
                <view class="office-title">{{ ticket_info.office_name }}</view>
                <view class="office-address">{{ ticket_info.address }}</view>
            </view>
        </view>

        <!-- 票务信息区域 -->
        <view class="ticket-info-container">
            <view class="date-container">
                <view class="title">日期</view>
                <view class="date">{{ ticket_info.date_selection }}</view>
            </view>
            <view class="time-container">
                <view class="title">时间</view>
                <view class="time">{{ start_time }}-{{ end_time }}</view>
            </view>
            <view class="status-container">
                <view class="title">状态</view>
                <!-- 当前时间大于结束时间为”已结束“，大于开始时间是”进行中“，小于开始时间是”未开始“ -->
                <view class="status">{{ ticket_status }}</view>
            </view>
        </view>


    </navigator>
</template>

