				"navigationBarTitleText": "赠送积分"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/profile/profile",
			"style": {
				"navigationBarTitleText": "个人设置"
			}
		},
		{
			"path": "pages/collect_list/collect_list",
			"style": {
				"navigationBarTitleText": "我的收藏"
			}
		},
		{
			"path": "pages/involve_list/involve_list",
			"style": {
				"navigationBarTitleText": "我参与的"
			}
		},
		{
			"path": "pages/access_ticket/access_ticket",
			"style": {
				"navigationBarTitleText": "门禁使用"
			}
		},
		{
			"path": "pages/contact_staff/contact_staff",
			"style": {
				"navigationBarTitleText": "联系客服"
			}
		},
		{
			"path": "pages/promotion/promotion",
			"style": {
				"navigationBarTitleText": "推广"
			}
		},
		{
			"path": "pages/order_detail/order_detail",
			"style": {
				"navigationBarTitleText": "订单详情"
			}
		},
		{
			"path": "pages/checkin_data/checkin_data",
			"style": {
				"navigationBarTitleText": "签到统计"
			}
		},
		{
			"path": "pages/promotion_reward/promotion_reward",
			"style": {
				"navigationBarTitleText": "推广收益"
			}
		},
		{
			"path": "pages/agreement/login_agreement", // 用户登录界面的隐私条款
			"style": {
				"navigationBarTitleText": "隐私条款"
			}
		},
		{
			"path": "pages/agreement/member_agreement", // 会员充值的协议
			"style": {
				"navigationBarTitleText": "折扣权益协议"
			}
		},
		{
			"path": "pages/agreement/order_agreement", // 预订会议室的协议
			"style": {
				"navigationBarTitleText": "场地使用须知"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	}
